APP_NAME=EcoCycle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Africa/Lagos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecocycle
DB_USERNAME=root
DB_PASSWORD=

# --- Mail (Mailtrap sandbox) --------------------------------------------
# Paste the Username and Password from your Mailtrap inbox's SMTP settings.
# Leave them blank and mail falls back to the log driver automatically.


# --- Claude --------------------------------------------------------------
# Paste your Anthropic key. Every AI feature degrades gracefully without it.

# --- EcoCycle ------------------------------------------------------------
ECOCYCLE_HOUSEHOLD_SHARE=0.60
ECOCYCLE_AGENT_SHARE=0.40
ECOCYCLE_VARIANCE_TOLERANCE=5.0

# --- Mail -----------------------------------------------------------------
# ACTIVE: Mailtrap sandbox, for testing. Nothing here reaches a real inbox --
# every message lands in your Mailtrap inbox no matter who it is addressed to,
# which is exactly what you want while seeded demo addresses are flying around.
# Paste the Username and Password from your inbox's SMTP Settings tab.
# Leave them blank and mail falls back to the log driver automatically.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

MAIL_FROM_ADDRESS=ops@ecocycle.ng
MAIL_FROM_NAME=EcoCycle

# --- Mail: Resend (production) --------------------------------------------
# When you are done testing: comment out the five Mailtrap lines above, paste
# your key below, and uncomment these two. Nothing else changes -- the app
# reads config('mail.default'), and every notification is transport-agnostic.
#
# Before switching, verify the sending domain in the Resend dashboard and set
# MAIL_FROM_ADDRESS to an address on it. Resend rejects mail from an
# unverified domain, and the failure looks like a 403 rather than a bounce.
#
# MAIL_MAILER=resend
# RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI ---------------------------------------------------------------
# Paste your OpenAI key. Both AI features degrade gracefully without it: the
# analytics screen phrases the same figures locally, and the photo classifier
# returns a stored default and says so.
#
# OPENAI_MODEL only has to phrase figures we already computed, so the small
# fast model is the right one. OPENAI_VISION_MODEL reads pickup photographs.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- EcoCycle -------------------------------------------------------------
ECOCYCLE_HOUSEHOLD_SHARE=0.60
ECOCYCLE_AGENT_SHARE=0.40
ECOCYCLE_VARIANCE_TOLERANCE=5.0
